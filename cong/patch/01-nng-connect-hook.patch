+// Runs the authentication hook installed by the application layer. Returns
+// NNG_MQTT_SUCCESS when the client is accepted - including when no hook is
+// installed, which is the signal for the caller to fall back to
+// verify_connect() - and the CONNACK reason code to send when refused, using
+// the same codes as verify_connect().
+static uint8_t
+nano_pipe_connect_auth(nano_pipe *p)
+{
+	nano_connect_params params;
+	conn_param         *cp = p->conn_param;
+
+	if (!nano_connect_auth_enabled()) {
+		return (NNG_MQTT_SUCCESS);
+	}
+
+	params.clientid    = conn_param_get_clientid(cp);
+	params.username    = (const char *) conn_param_get_username(cp);
+	params.password    = (const char *) conn_param_get_password(cp);
+	params.ip_addr     = conn_param_get_ip_addr_v4(cp);
+	params.proto_name  = (const char *) conn_param_get_pro_name(cp);
+	params.proto_ver   = conn_param_get_protover(cp);
+	params.clean_start = conn_param_get_clean_start(cp) == 1;
+
+	if (nano_connect_auth_call(&params)) {
+		return (NNG_MQTT_SUCCESS);
+	}
+	log_warn("authentication hook refused clientid [%s] username [%s]",
+	    params.clientid != NULL ? params.clientid : "",
+	    params.username != NULL ? params.username : "");
+	return (params.proto_ver == 5 ? BAD_USER_NAME_OR_PASSWORD : 0x05);
+}

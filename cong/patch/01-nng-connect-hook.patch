+//
+// This software is supplied under the terms of the MIT License, a
+// copy of which should be located in the distribution where this
+// file was obtained (LICENSE.txt).  A copy of the license may also be
+// found online at https://opensource.org/licenses/MIT.
+//
+#ifndef NNG_PROTOCOL_MQTT_CONNECT_HOOK_H
+#define NNG_PROTOCOL_MQTT_CONNECT_HOOK_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <nng/nng.h>
+
+// The identity of a client that has just sent a CONNECT packet, handed to
+// the authentication hook installed by the application layer.
+//
+// Every pointer is owned by the protocol stack and stays valid only for the
+// duration of the callback, so a hook that keeps any of it must copy it.
+typedef struct nano_connect_params {
+	const char *clientid;
+	// NULL when the client sent no username. When the broker maps a TLS
+	// client certificate to a username, this is the mapped name.
+	const char *username;
+	// The password as it arrived on the wire; the hook decides the format.
+	const char *password;
+	const char *ip_addr;
+	const char *proto_name;
+	uint8_t     proto_ver;
+	bool        clean_start;
+} nano_connect_params;
+
+// Returns true to accept the connection and false to refuse it. A refused
+// connection gets the same CONNACK reason code the built-in username and
+// password check would have used.
+typedef bool (*nano_connect_auth_cb)(nano_connect_params *params);
+
+// Installs the hook that decides CONNECT authentication. Passing NULL removes
+// it and restores the built-in behaviour. Only one hook can be installed, and
+// it must be installed before the broker starts listening, because the
+// protocol stack reads the pointer without locking.
+NNG_DECL void nano_connect_auth_set(nano_connect_auth_cb cb);
+
+// Whether a hook is installed. The built-in check is skipped when one is, so
+// that exactly one policy decides a connection.
+NNG_DECL bool nano_connect_auth_enabled(void);
+
+// Used by the MQTT protocol stack: runs the installed hook, and accepts the
+// connection when no hook is installed.
+NNG_DECL bool nano_connect_auth_call(nano_connect_params *params);
+
+#endif // NNG_PROTOCOL_MQTT_CONNECT_HOOK_H

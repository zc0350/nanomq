diff --git a/src/sp/protocol/mqtt/connect_hook.c b/src/sp/protocol/mqtt/connect_hook.c
new file mode 100644
index 0000000..52c23e5
--- /dev/null
+++ b/src/sp/protocol/mqtt/connect_hook.c
@@ -0,0 +1,41 @@
+//
+// Copyright 2024 NanoMQ Team, Inc. <jaylin@emqx.io>
+//
+// This software is supplied under the terms of the MIT License, a
+// copy of which should be located in the distribution where this
+// file was obtained (LICENSE.txt).  A copy of the license may also be
+// found online at https://opensource.org/licenses/MIT.
+//
+// The protocol stack cannot call into the broker application, so the
+// authentication hook is a function pointer the application installs here and
+// nano_pipe_start() calls. See the note in connect_hook.h: the pointer is read
+// from the CONNECT path without locking, so it has to be set before listeners
+// accept their first connection.
+#include "core/nng_impl.h"
+#include "nng/protocol/mqtt/connect_hook.h"
+
+static nano_connect_auth_cb nano_connect_auth_hook = NULL;
+
+void
+nano_connect_auth_set(nano_connect_auth_cb cb)
+{
+	nano_connect_auth_hook = cb;
+}
+
+bool
+nano_connect_auth_enabled(void)
+{
+	return (nano_connect_auth_hook != NULL);
+}
+
+// Internal: runs the installed hook. Returns true when the connection is
+// accepted, including when no hook is installed, so callers can read it as
+// "the hook did not refuse this client".
+bool
+nano_connect_auth_call(nano_connect_params *params)
+{
+	if (nano_connect_auth_hook == NULL) {
+		return (true);
+	}
+	return (nano_connect_auth_hook(params));
+}
